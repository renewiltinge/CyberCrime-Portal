# Cloudflare Pages: extra HTTP-headers voor elke pagina.
# Andere hosts (GitHub Pages, lokaal openen) negeren dit bestand.
/*
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin
  X-Frame-Options: SAMEORIGIN

# De pagina zelf altijd opnieuw controleren: zo komen nieuwe ?v=-URL's (en dus nieuwe rooms en
# leerpaden) direct door. Scripts en stylesheets hebben een inhoudshash in hun URL (tools/build.js).
/
  Cache-Control: no-cache
/index.html
  Cache-Control: no-cache
